# Copy to <repo>/credentials.env (gitignored) and fill in. No inline comments: docker env_file reads values literally.
BOT_TOKEN=
# GigaChat "Authorization key" (base64 of ClientID:Secret) from developers.sber.ru
GIGACHAT_CLIENT_ID=
GIGACHAT_AUTH_KEY=
GIGACHAT_SCOPE=GIGACHAT_API_PERS
GIGACHAT_MODEL=GigaChat-2-Pro
# openrouter | fake
IMAGE_PROVIDER=openrouter
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-3.1-flash-lite-image
# :80 until the domain is ready; then e.g. imgrsz.ru (Caddy gets HTTPS automatically)
DOMAIN=:80
